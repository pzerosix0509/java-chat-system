<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.chatapp</groupId>
  <artifactId>java-chat-system</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Java Chat System</name>
  <description>Do an cuoi ky - he thong chat 2 phan he (admin, user)</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <javafx.version>21</javafx.version>
    <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
    <ikonli.version>12.3.1</ikonli.version>
  </properties>

  <!--
    TODO khi bat dau implement: them cac dependency
      - org.openjfx:javafx-controls / javafx-fxml / javafx-graphics (${javafx.version})
      - com.mysql:mysql-connector-j
      - com.fasterxml.jackson.core:jackson-databind
      - ch.qos.logback:logback-classic
      - org.junit.jupiter:junit-jupiter (scope test)
    Va plugin:
      - org.openjfx:javafx-maven-plugin
      - maven-shade-plugin (tao 2 jar cho admin/user, co Main-Class rieng)
  -->
  <dependencies>
    <!--
        Chứa các thành phần giao diện JavaFX:
        Button, Label, TextField, TableView,
        LineChart, BarChart, TabPane...
    -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!--
        Cho phép dùng FXMLLoader để đọc
        các file giao diện .fxml
    -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Icon vector -->
    
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-javafx</artifactId>
      <version>${ikonli.version}</version>
    </dependency>

    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-fontawesome5-pack</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
    <!--
        Plugin giúp Maven khởi động
        ứng dụng JavaFX.
    -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx.maven.plugin.version}</version>
        <configuration>
          <mainClass>${app.mainClass}</mainClass>
        </configuration>
      </plugin>

    </plugins>
  </build>


  <!--
      Tách cấu hình chạy Admin và User,
      tránh phải sửa pom.xml mỗi lần chạy.
  -->
  <profiles>
  <!-- Chạy phân hệ Admin -->
    <profile>
      <id>admin-ui</id>
      <properties>
        <app.mainClass>com.chatapp.admin.AdminApp</app.mainClass>
      </properties>
    </profile>

    <!-- Chạy phân hệ Admin -->
    <profile>
      <id>user-ui</id>
      <properties>
        <app.mainClass>com.chatapp.user.UserApp</app.mainClass>
      </properties>
    </profile>
  </profiles>
  
</project>
