        <FontIcon iconLiteral="fas-id-card" iconSize="32" styleClass="empty-page-icon" />
        <Label text="Chi tiết người dùng" styleClass="empty-page-title" />
        <Label text="Thông tin và các hành động quản trị người dùng sẽ được xây dựng sau"
               styleClass="empty-page-description" />
    </VBox>
