<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chatapp.admin.controller.SpamReportDetailController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="detail-scroll">
    <content>
            <VBox spacing="10" styleClass="admin-page,spam-detail-page">
            <Button text="Danh sách báo cáo"
                    onAction="#goBack"
                    styleClass="button-outline,detail-back-button">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left" iconSize="13" />
                </graphic>
            </Button>

            <VBox spacing="16" styleClass="spam-report-header">
                <VBox spacing="6">
                    <Label fx:id="reportCodeLabel" styleClass="spam-report-code" />
                    <Label fx:id="reportReasonLabel"
                           wrapText="true"
                           styleClass="spam-report-title" />
                    <HBox alignment="CENTER_LEFT" spacing="9">
                        <Label fx:id="reportTimeLabel" styleClass="spam-report-time" />
                        <Label fx:id="reportStatusLabel" styleClass="spam-status-badge" />
                    </HBox>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="spam-report-parties">
                    <VBox spacing="7" HBox.hgrow="ALWAYS">
                        <Label text="NGƯỜI BÁO CÁO" styleClass="spam-party-label" />
                        <HBox alignment="CENTER_LEFT" spacing="9">
                            <Label fx:id="reporterAvatarLabel" styleClass="spam-party-avatar" />
                            <VBox spacing="3">
                                <Label fx:id="reporterNameLabel" styleClass="table-user-name" />
                                <Label fx:id="reporterUsernameLabel" styleClass="table-user-username" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <FontIcon iconLiteral="fas-arrow-right" iconSize="15"
                              styleClass="spam-party-arrow" />
                    <VBox spacing="7" HBox.hgrow="ALWAYS">
                        <Label text="NGƯỜI BỊ BÁO CÁO" styleClass="spam-party-label" />
                        <HBox alignment="CENTER_LEFT" spacing="9">
                            <Label fx:id="accusedAvatarLabel" styleClass="spam-party-avatar,spam-party-avatar-accused" />
                            <VBox spacing="3">
                                <Label fx:id="accusedNameLabel" styleClass="table-user-name" />
                                <Label fx:id="accusedUsernameLabel" styleClass="table-user-username" />
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <GridPane fx:id="decisionGrid" hgap="10" vgap="10"
                      styleClass="spam-report-layout">
                <columnConstraints>
                    <ColumnConstraints percentWidth="62" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="38" hgrow="ALWAYS" />
                </columnConstraints>
                <VBox fx:id="reportMain" spacing="16"
                      GridPane.columnIndex="0" GridPane.rowIndex="0"
                      styleClass="spam-report-main">
                    <VBox styleClass="card">
                        <HBox spacing="9" styleClass="card-head">
                            <FontIcon iconLiteral="fas-comment-dots" iconSize="15"
                                      styleClass="spam-section-icon" />
                            <VBox spacing="3">
                                <Label text="Nội dung báo cáo" styleClass="spam-section-title" />
                                <Label text="Mô tả do người báo cáo cung cấp"
                                       styleClass="spam-section-subtitle" />
                            </VBox>
                        </HBox>
                        <VBox spacing="12" styleClass="card-body">
                            <Label fx:id="reportContentLabel"
                                   wrapText="true"
                                   styleClass="spam-report-message" />
                            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="spam-context-meta">
                                <HBox alignment="CENTER_LEFT" spacing="5">
                                    <FontIcon iconLiteral="fas-clock" iconSize="12" />
                                    <Label fx:id="contextTimeLabel" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="5">
                                    <FontIcon iconLiteral="fas-comments" iconSize="12" />
                                    <Label fx:id="contextTypeLabel" />
                                </HBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox styleClass="card">
                        <HBox spacing="9" styleClass="card-head">
                            <FontIcon iconLiteral="fas-file-alt" iconSize="15"
                                      styleClass="spam-section-icon" />
                            <VBox spacing="3">
                                <Label text="Bằng chứng đính kèm" styleClass="spam-section-title" />
                                <Label text="Ảnh chụp màn hình và trích đoạn liên quan"
                                       styleClass="spam-section-subtitle" />
                            </VBox>
                        </HBox>
                        <FlowPane fx:id="evidenceList"
                                  hgap="10" vgap="10"
                                  styleClass="card-body,spam-evidence-grid" />
                    </VBox>
                </VBox>

                <VBox fx:id="decisionPanel"
                      spacing="0"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0"
                      styleClass="card,spam-decision-panel">
                    <HBox spacing="9" styleClass="card-head">
                        <FontIcon iconLiteral="fas-shield-alt" iconSize="15"
                                  styleClass="spam-section-icon" />
                        <VBox spacing="3">
                            <Label text="Xử lý báo cáo" styleClass="spam-section-title" />
                            <Label text="Thông báo là bắt buộc với mọi quyết định"
                                   styleClass="spam-section-subtitle" />
                        </VBox>
                    </HBox>
                    <VBox spacing="13" styleClass="card-body">
                        <HBox alignment="TOP_LEFT" spacing="8" styleClass="spam-decision-note">
                            <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="14" />
                            <Label text="Chỉ khóa tài khoản sau khi đã kiểm tra nội dung và bằng chứng."
                                   wrapText="true" />
                        </HBox>

                        <VBox spacing="6" styleClass="spam-decision-field">
                            <Label text="THỜI HẠN KHÓA" styleClass="filter-label" />
                            <ComboBox fx:id="durationComboBox"
                                      maxWidth="Infinity"
                                      styleClass="filter-input" />
                        </VBox>

                        <VBox spacing="6" styleClass="spam-decision-field">
                            <Label text="LÝ DO QUẢN TRỊ" styleClass="filter-label" />
                            <TextArea fx:id="adminReasonArea"
                                      promptText="Ghi nhận đánh giá và căn cứ đưa ra quyết định..."
                                      wrapText="true"
                                      styleClass="spam-decision-textarea" />
                        </VBox>

                        <VBox spacing="6" styleClass="spam-decision-field">
                            <Label text="THÔNG BÁO CHO NGƯỜI BÁO CÁO" styleClass="filter-label" />
                            <TextArea fx:id="reporterMessageArea"
                                      promptText="Thông báo kết quả xử lý cho người báo cáo..."
                                      wrapText="true"
                                      styleClass="spam-decision-textarea" />
                            <Label text="Thông báo là bắt buộc cho cả hai lựa chọn."
                                   wrapText="true"
                                   styleClass="spam-field-help" />
                        </VBox>

                        <Label fx:id="validationLabel"
                               visible="false"
                               managed="false"
                               wrapText="true"
                               styleClass="spam-validation" />

                        <HBox spacing="8" styleClass="spam-decision-actions">
                            <Button fx:id="lockAccountButton"
                                    text="Khóa tài khoản"
                                    onAction="#lockAccount"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="button-lock,spam-lock-action">
                                <graphic>
                                    <FontIcon iconLiteral="fas-lock" iconSize="13" />
                                </graphic>
                            </Button>
                            <Button fx:id="noLockButton"
                                    text="Không khóa"
                                    onAction="#doNotLock"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="button-no-lock,spam-no-lock-action">
                                <graphic>
                                    <FontIcon iconLiteral="fas-check" iconSize="13" />
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
