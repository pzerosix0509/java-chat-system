<?xml version="1.0" encoding="UTF-8"?>

<?import com.chatapp.admin.component.FilterBar?>
<?import com.chatapp.admin.component.SortableTableView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chatapp.admin.controller.UserManagementController"
      spacing="14"
      styleClass="admin-page">

    <HBox alignment="CENTER_LEFT"
          spacing="16"
          styleClass="page-heading">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Danh sách người dùng"
                   styleClass="page-heading-title" />
            <Label text="Quản lý thông tin và trạng thái tài khoản."
                   styleClass="page-heading-description" />
        </VBox>

        <Button text="Thêm người dùng"
                onAction="#addUser"
                styleClass="button-primary">
            <graphic>
                <FontIcon iconLiteral="fas-user-plus"
                          iconSize="14" />
            </graphic>
        </Button>
    </HBox>

    <FilterBar>
        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="filter-field,filter-grow">
            <Label text="TÌM KIẾM" styleClass="filter-label" />
            <TextField fx:id="keywordField"
                       promptText="Nhập tên, username hoặc email..."
                       onAction="#applyFilters"
                       styleClass="filter-input" />
        </VBox>

        <VBox spacing="6" styleClass="filter-field">
            <Label text="TRẠNG THÁI" styleClass="filter-label" />
            <ComboBox fx:id="statusFilter"
                      prefWidth="150"
                      styleClass="filter-input" />
        </VBox>

        <VBox spacing="6" styleClass="filter-field">
            <Label text="SẮP XẾP THEO" styleClass="filter-label" />
            <ComboBox fx:id="sortFieldFilter"
                      prefWidth="135"
                      styleClass="filter-input" />
        </VBox>

        <VBox spacing="6" styleClass="filter-field">
            <Label text="THỨ TỰ" styleClass="filter-label" />
            <ComboBox fx:id="sortDirectionFilter"
                      prefWidth="125"
                      styleClass="filter-input" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Button text="Áp dụng"
                onAction="#applyFilters"
                styleClass="button-primary,filter-button" />

        <Button text="Đặt lại"
                onAction="#resetFilters"
                styleClass="button-outline,filter-button" />
    </FilterBar>

    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <SortableTableView fx:id="usersTable"
                           VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="userColumn"
                             text="NGƯỜI DÙNG"
                             prefWidth="205" />
                <TableColumn fx:id="emailColumn"
                             text="EMAIL"
                             prefWidth="185" />
                <TableColumn fx:id="genderColumn"
                             text="GIỚI TÍNH"
                             prefWidth="80" />
                <TableColumn fx:id="createdAtColumn"
                             text="NGÀY TẠO"
                             prefWidth="100" />
                <TableColumn fx:id="statusColumn"
                             text="TRẠNG THÁI"
                             prefWidth="125" />
                <TableColumn fx:id="actionColumn"
                             text="THAO TÁC"
                             prefWidth="205"
                             sortable="false" />
            </columns>
        </SortableTableView>

        <HBox alignment="CENTER_LEFT"
              spacing="8"
              styleClass="table-pagination">
            <Label fx:id="paginationLabel"
                   styleClass="pagination-copy" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="‹" styleClass="pagination-button" />
            <Button text="1" styleClass="pagination-button,pagination-active" />
            <Button text="2" styleClass="pagination-button" />
            <Button text="3" styleClass="pagination-button" />
            <Button text="›" styleClass="pagination-button" />
        </HBox>
    </VBox>

</VBox>
